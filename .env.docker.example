# ================================================================
#  CONTROL PRESUPUESTAL — Variables de entorno para Docker Compose
# ================================================================
#  1) Copia este archivo:
#       Copy-Item .env.docker.example .env
#  2) Completa los valores marcados como CHANGEME.
#  3) NUNCA subas el archivo .env real al repositorio.
# ================================================================

# ── POSTGRES (servicio "db") ───────────────────────────────────
POSTGRES_DB=presupuesto_db
POSTGRES_USER=postgres
# Genera una password fuerte. En PowerShell:
#   -join ((1..32) | ForEach-Object { [char](Get-Random -Min 33 -Max 126) })
POSTGRES_PASSWORD=CHANGEME_password_fuerte_de_postgres

# ── APLICACIÓN (servicio "app") ────────────────────────────────
NODE_ENV=production

# Puerto en el host donde se publicará la app.
# Cámbialo si el 3000 ya está ocupado (ej. APP_HOST_PORT=8080).
APP_HOST_PORT=3000

# SSL hacia Postgres. En docker-compose local: false.
# Solo true si conectas a un Postgres administrado externo.
PGSSL=false

# Tamaño del pool de Postgres.
PG_POOL_MAX=20

# Orígenes permitidos para CORS. Lista separada por comas.
# Obligatorio en NODE_ENV=production. Ejemplo:
#   ALLOWED_ORIGINS=http://localhost:3000,https://presupuestal.ecatepec.gob.mx
ALLOWED_ORIGINS=http://localhost:3000

# Secreto JWT — mínimo 32 caracteres en producción.
# Generar con PowerShell:
#   -join ((1..64) | ForEach-Object { '{0:x2}' -f (Get-Random -Min 0 -Max 256) })
# o con Node ya instalado:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGEME_genera_un_secreto_hex_de_64_bytes_minimo

# Primer arranque: true para poblar la tabla partidas_permitidas.
# Después del primer up exitoso, ponlo en false y haz:
#   docker compose up -d
# para que NO vuelva a sembrar en cada reinicio.
SEED=true

# Prefijo institucional para folios (ECA-YYYY-MM-...-NNNN)
MUNICIPIO_PREFIJO_FOLIO=ECA
