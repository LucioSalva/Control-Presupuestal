# DATABASE_URL=postgres://postgres:admin@170.10.1.60:5432/presupuesto_db
# PGSSL=false
# PORT=3000


DATABASE_URL=postgres://postgres:admin@localhost:5432/presupuesto_db
PGSSL=false
PORT=3000
SEED=false
NODE_ENV=production

# CORS: orígenes permitidos (comma-separated). Dejar vacío en dev = usa localhost.
# En producción: ALLOWED_ORIGINS=https://presupuestal.ecatepec.gob.mx
ALLOWED_ORIGINS=http://localhost:3000

# Pool PostgreSQL: conexiones máximas (default 20)
PG_POOL_MAX=20

